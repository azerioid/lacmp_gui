#!/bin/bash
# Privileged broker launcher.
#
# 1. LCMP's CLI php.ini often sets open_basedir / disable_functions. Clear
#    both so this process can write Caddy config and spawn argv (no shell).
# 2. PHP-FPM runs with ProtectSystem=full. sudo keeps that mount namespace,
#    so /etc is EROFS even as root. Re-exec via systemd-run so PID 1 starts
#    us in a normal namespace. Fallback: FPM ReadWritePaths punch-holes.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF="${ROOT}/broker"

PHP_BIN="${LCMP_BROKER_PHP:-}"
if [[ -z "${PHP_BIN}" ]]; then
    PHP_BIN="$(command -v php || true)"
fi
if [[ -z "${PHP_BIN}" || ! -x "${PHP_BIN}" ]]; then
    PHP_BIN=/usr/bin/php
fi

if [[ -z "${LCMP_BROKER_UNSANDBOXED:-}" ]] \
    && [[ -d /run/systemd/system ]] \
    && command -v systemd-run >/dev/null 2>&1; then
    export LCMP_BROKER_UNSANDBOXED=1
    exec systemd-run --quiet --wait --pipe --collect \
        --working-directory="${ROOT}" \
        -E LCMP_BROKER_UNSANDBOXED=1 \
        -E LCMP_BROKER_PHP="${PHP_BIN}" \
        -E LCMP_PANEL_CONFIG="${LCMP_PANEL_CONFIG:-/etc/lcmp-panel/broker.json}" \
        -E PATH="${PATH}" \
        -- "${SELF}" "$@"
fi

exec "${PHP_BIN}" \
    -d open_basedir= \
    -d disable_functions= \
    "${ROOT}/broker.php" "$@"
