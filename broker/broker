#!/bin/bash
# Privileged broker launcher. LCMP's CLI php.ini often sets open_basedir to
# the www tree and disable_functions (proc_open). That would make this process
# unable to write /etc/caddy or spawn caddy/systemctl even when sudo has
# already given us root. Clear both for this invocation only.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PHP_BIN="${LCMP_BROKER_PHP:-}"
if [[ -z "${PHP_BIN}" ]]; then
    PHP_BIN="$(command -v php || true)"
fi
if [[ -z "${PHP_BIN}" || ! -x "${PHP_BIN}" ]]; then
    PHP_BIN=/usr/bin/php
fi
exec "${PHP_BIN}" \
    -d open_basedir= \
    -d disable_functions= \
    "${ROOT}/broker.php" "$@"
