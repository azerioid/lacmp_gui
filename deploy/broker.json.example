        "caddy_bin": "/usr/bin/caddy",
        "vhost_dir": "/etc/caddy/conf.d",
        "vhost_available": "",
        "web_log_dir": "/var/log/caddy",
        "apache_ctl": "",
        "audit_log": "/var/log/lacmp-panel/broker-audit.log",
        "mariadb_server_cnf": "/etc/mysql/mariadb.conf.d/50-server.cnf",
        "artisan": "/usr/local/lib/lacmp-panel/web/artisan",
